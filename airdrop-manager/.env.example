# --- Web server ---
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8090

# --- Database ---
# Path to SQLite file (relative to airdrop-manager/ working dir)
DB_PATH=data/airdrop.db

# --- Telegram reminder (optional) ---
# Get a token from @BotFather. Leave empty to disable Telegram notifications.
TELEGRAM_BOT_TOKEN=
# Your numeric chat id (use @userinfobot on Telegram to find yours)
TELEGRAM_CHAT_ID=

# Reminder times (24h, local server time). Comma-separated, HH:MM
REMINDER_TIMES=08:00,20:00

# Daily task reset time (when 'daily' tasks become 'pending' again)
DAILY_RESET_TIME=00:05

# Timezone (IANA format, e.g. Asia/Jakarta, UTC)
TIMEZONE=Asia/Jakarta
