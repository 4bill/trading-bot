# --- Telegram ---
# Get a token from @BotFather. NEVER commit the real value.
TELEGRAM_BOT_TOKEN=replace_me

# Public HTTPS URL where the web app (form) is served.
# Telegram Mini Apps REQUIRE HTTPS. For local dev use ngrok / cloudflared.
# Example: https://your-tunnel.ngrok-free.app
WEBAPP_URL=https://example.com

# --- Web server ---
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# --- Exchange (ccxt) ---
# Name of the ccxt exchange, e.g. binance, bybit, okx, kraken
EXCHANGE=binance
# Use testnet / sandbox if the exchange supports it (recommended while testing)
EXCHANGE_TESTNET=true

# Optional: default API creds. You can also supply them through the form.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
